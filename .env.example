# =========================================================================
# PricePilot AI System Production Environment Configurations Template
# =========================================================================

# -------------------------------------------------------------------------
# 1. Database Connection Parameters
# -------------------------------------------------------------------------
# Individual connection attributes (FastAPI backend uses these to build pool connections)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password123
DB_NAME=pricepilot_ai

# Fallback unified SQLAlchemy URL syntax
DATABASE_URL=postgresql://postgres:password123@localhost:5432/pricepilot_ai

# -------------------------------------------------------------------------
# 2. Google Gemini Generative AI Settings
# -------------------------------------------------------------------------
# Exposes active AI pipelines for pricing optimization and demand forecast synthesizers.
# Omit or leave empty in developer environment sandboxes to trigger fallback mock models.
GOOGLE_API_KEY=AIzaSyYourGeminiApiKeyHere

# -------------------------------------------------------------------------
# 3. Frontend Compilation Variable Settings
# -------------------------------------------------------------------------
# Production endpoint URL. Empty/omitted value causes frontend calls to route relatively (e.g. /api/...)
VITE_API_URL=

# -------------------------------------------------------------------------
# 4. Security & CORS Settings
# -------------------------------------------------------------------------
# Standard CORS header values (e.g., origin limits)
CORS_ORIGINS=["http://localhost:5173", "https://pricepilot.vercel.app"]
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
